  "book_template": "Pathfinder Adventure",
  "title": "The Ashen Compass",
  "author": "Example Creator",
  "system": "Pathfinder 2e (Remaster)",
  "levels": "1–5",
  "tone": "Mystery and exploration",
  "pitch": "A compass points not north, but toward what its bearer most regrets.",
  "setting": "The coastal city of Greywake sits beside a sea that sometimes forgets its tide.",
  "story_arc": "The party recovers a peculiar compass, follows its shifting bearing, and discovers why the lighthouse went dark.",
  "entries": [
    {
      "id": "ab28eb52-eec0-4c3f-bb14-5e0d1745658e",
      "category": "Chapter",
      "title": "Chapter One: The Unlit Lighthouse",
      "content": "The party arrives during the annual Lantern Festival. Every flame goes out at midnight.\n\nOpening scene: The keeper's daughter offers a reward for finding her missing father.",
      "gm_only": false
    },
    {
      "id": "57ba35f2-c894-40f1-a21b-9c43f47c033b",
      "category": "NPC",
      "title": "Mara Venn, Harbor Cartographer",
      "content": "Goal: Keep her father's disappearance secret.\nMannerism: Always checks the horizon before answering.\nClue: Her maps show a coastline that should not exist.",
      "gm_only": false
    },
    {
      "id": "d657b673-6fa8-4fb0-ba12-6eb0b38ac522",
      "category": "Encounter",
      "title": "The Drowned Archive",
      "content": "Location: Flooded basement beneath the lighthouse.\nThreat: Unstable walkways and an unknown guardian.\nChoice: Rescue a trapped scholar or preserve the evidence.",
      "gm_only": false
    },
    {
      "id": "66de6f79-a91a-4a03-99d5-ffd8fb45fe1f",
      "category": "Secret",
      "title": "The Keeper's Bargain",
      "content": "The missing keeper once traded the town's memories for calm seas.",
      "gm_only": true
    }
  ],
